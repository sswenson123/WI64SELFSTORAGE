{
  "name": "wi64-moveout-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "migrate:local": "wrangler d1 migrations apply wi64_moveout --local",
    "migrate:remote": "wrangler d1 migrations apply wi64_moveout --remote",
    "test:web": "node e2e/run.mjs",
    "test:all": "npm run test && npm run test:web"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vitest": "2.1.8",
    "wrangler": "^3.99.0"
  }
}
